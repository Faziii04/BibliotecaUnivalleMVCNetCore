@model IEnumerable<MVCPractice.Models.Book>
@{
    ViewData["Title"] = "Libros";
    var esBibliotecario = User.IsInRole("Administrador") || User.IsInRole("Bibliotecario");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@(esBibliotecario ? "Administracion de libros" : "Catalogo de libros")</h1>
    @if (esBibliotecario)
    {
        <a class="btn btn-primary" asp-action="Create">Nuevo libro</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por titulo" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron libros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Titulo</th>
                    <th>Autores</th>
                    <th>Categoria</th>
                    <th>Formato</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in Model)
                {
                    <tr>
                        <td>@libro.Name</td>
                        <td>
                            @if (libro.BookAuthors.Any())
                            {
                                @string.Join(", ", libro.BookAuthors.Select(ba => ba.Author.FirstName + " " + ba.Author.LastName))
                            }
                            else
                            {
                                <span class="text-muted">Sin autores</span>
                            }
                        </td>
                        <td>@(libro.Category ?? "-")</td>
                        <td>@(libro.Format ?? "-")</td>
                        <td class="text-end">@(libro.Price.HasValue ? libro.Price.Value.ToString("N2") : "-")</td>
                        <td class="text-center">
                            @if (libro.Stock > 0)
                            {
                                <span class="badge bg-success">@libro.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">0</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@libro.LibroId">Ver</a>
                            @if (esBibliotecario)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@libro.LibroId">Editar</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@libro.LibroId">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
