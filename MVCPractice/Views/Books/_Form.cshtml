@model MVCPractice.ViewModels.BookFormModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" type="number" min="0" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="Lenght" class="form-label"></label>
        <input asp-for="Lenght" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Format" class="form-label"></label>
        <input asp-for="Format" class="form-control" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="AgeGroup" class="form-label"></label>
        <input asp-for="AgeGroup" class="form-control" />
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="PublishingDate" class="form-label"></label>
        <input asp-for="PublishingDate" class="form-control" type="date" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="SelectedAuthorIds" class="form-label"></label>
        <select asp-for="SelectedAuthorIds" asp-items="ViewBag.Autores" class="form-select" multiple size="6"></select>
        <div class="form-text">Use Ctrl para seleccionar varios autores.</div>
    </div>
</div>
