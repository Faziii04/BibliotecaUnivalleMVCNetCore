@model IEnumerable<MVCPractice.Models.Loan>
@{
    ViewData["Title"] = "Prestamos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Prestamos registrados</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo prestamo</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por libro o correo" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay prestamos para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Libro</th>
                    <th>Usuario</th>
                    <th>Fecha</th>
                    <th class="text-center">Dias</th>
                    <th>Devolucion</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in Model)
                {
                    <tr>
                        <td>@prestamo.Libro.Name</td>
                        <td>@prestamo.Usuario.Email</td>
                        <td>@prestamo.LoanDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@(prestamo.LoanDurationDays ?? 0)</td>
                        <td>@(prestamo.ReturnDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            @if (prestamo.IsReturned)
                            {
                                <span class="badge bg-success">Devuelto</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Prestado</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@prestamo.BorrowId">Ver</a>
                            @if (!prestamo.IsReturned)
                            {
                                <form method="post" asp-action="Return" asp-route-id="@prestamo.BorrowId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Devolver</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@prestamo.BorrowId">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@prestamo.BorrowId">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
