@model MVCPractice.Models.User
@{
    ViewData["Title"] = "Eliminar usuario";
    var rol = Model.Role.Trim();
}

<h1 class="h3 mb-3">Eliminar usuario</h1>

<div class="alert alert-warning">Confirme que desea eliminar este usuario.</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9">@rol</dd>
        </dl>
    </div>
</div>

<form method="post" asp-action="Delete" asp-route-id="@Model.UsuarioId">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
